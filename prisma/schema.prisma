generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TitleType {
  MOVIE
  SERIES
}

enum ListVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lists        List[]
  progress     UserProgress[]
}

model Title {
  id          String    @id @default(cuid())
  type        TitleType
  name        String
  overview    String
  year        Int?
  genres      String    // comma-separated, simple starter
  posterUrl   String?
  backdropUrl String?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seasons     Season[]
  episodes    Episode[]
  listItems   ListItem[]
}

model Season {
  id        String   @id @default(cuid())
  titleId   String
  number    Int
  name      String
  createdAt DateTime @default(now())

  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes  Episode[]

  @@unique([titleId, number])
}

model Episode {
  id          String    @id @default(cuid())
  titleId     String
  seasonId    String?
  number      Int?
  name        String
  overview    String?
  durationSec Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  title       Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season      Season?   @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  streams     Stream[]
  subtitles   SubtitleTrack[]
  progress    UserProgress[]
}

model Stream {
  id         String  @id @default(cuid())
  episodeId  String
  label      String  // e.g. "Auto", "1080p", "4K"
  url        String
  kind       String  // "hls" | "mp4" | "dash" (starter)
  bandwidth  Int?    // optional hint
  width      Int?
  height     Int?

  episode    Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model SubtitleTrack {
  id        String  @id @default(cuid())
  episodeId String
  language  String  // e.g. "ar", "en"
  label     String  // e.g. "Arabic", "English"
  url       String  // VTT url (can be local in /public)

  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  episodeId   String
  positionSec Int
  durationSec Int?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model List {
  id          String         @id @default(cuid())
  userId      String
  name        String
  visibility  ListVisibility @default(PRIVATE)
  shareToken  String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  titleId   String
  addedAt   DateTime @default(now())

  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([listId, titleId])
}
